!/tests/msp_admission/*.py
!/tests/msp_admission/*.lua
!/tests/msp_admission/README.md
!/tests/omp_auto/
/tests/omp_auto/*
!/tests/omp_auto/*.py
!/tests/omp_auto/*.lua
!/tests/omp_auto/README.md
!/tests/ownership/
