# Publish only the project files listed below; local notes and output stay private.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/docs/
!/tools/
!/tests/
!/src/
!/flights-count.csv
!/KSE4/
!/KSE5/
!/theme-gallery/

# Current maintainer contracts and source evidence.
/docs/*
!/docs/README.md
!/docs/compatibility.md
!/docs/edgetx-2.12.4-battery-icon-comparison.md
!/docs/edgetx-2.12.4-status-icons.md
!/docs/image-resource-limits.md
!/docs/omp-auto-identification-feasibility.md
!/docs/release-packaging.md
!/docs/rf-integration.md
!/docs/runtime-resources.md
!/docs/settings-menu.md
!/docs/telemetry-configuration-audit.md
!/docs/transmitter-validation.md

# Authored engine and renderers; generate the installable scripts with tools/assemble.py.
/src/*
!/src/README.md
!/src/shared/
/src/shared/*
!/src/shared/alerts.lua
!/src/shared/auto_heli.lua
!/src/shared/count_storage.lua
!/src/shared/counters.lua
!/src/shared/enums.lua
!/src/shared/images.lua
!/src/shared/lifecycle.lua
!/src/shared/msp_admission.lua
!/src/shared/omp_auto.lua
!/src/shared/options.lua
!/src/shared/rf.lua
!/src/shared/settings_store.lua
!/src/shared/settings_menu.lua
!/src/shared/state.lua
!/src/shared/telemetry.lua
!/src/shared/widget_owner.lua
!/src/variants/
/src/variants/*
!/src/variants/KSE4/
!/src/variants/KSE5/
/src/variants/KSE4/*
/src/variants/KSE5/*
!/src/variants/KSE4/*.lua
!/src/variants/KSE5/*.lua

# Reproducible host tooling and user image utilities.
/tools/*
!/tools/assemble.py
!/tools/edgetx/
!/tools/images/
/tools/edgetx/*
!/tools/edgetx/*.py
!/tools/edgetx/*.c
!/tools/edgetx/*.h
!/tools/edgetx/README.md
/tools/images/*
!/tools/images/KSE Image Resizer.html
!/tools/images/README.md
!/tools/images/Resize KSE Images.bat
!/tools/images/Resize KSE Images.command
!/tools/images/resize_kse_images.py

