# Publish the dashboard variants, gallery, and selected project instructions.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/docs/
!/tools/
!/tests/
!/src/
!/flights-count.csv
!/KSE4/
!/KSE5/
!/theme-gallery/

# Agent context and implementation evidence; keep other local notes private.
/docs/*
!/docs/implementation-plan.md
!/docs/KSE4-KSE5-optimization-review.md
!/docs/rf-adapter-design.md

# Host-side compatibility tooling and fixtures; never copy these to the radio.
/tools/*
!/tools/assemble.py
!/tools/edgetx/
/tools/edgetx/*
!/tools/edgetx/*.py
!/tools/edgetx/*.c
!/tools/edgetx/*.h
!/tools/edgetx/README.md
/tests/*
!/tests/behavior/
/tests/behavior/*
!/tests/behavior/*.py
!/tests/behavior/*.lua
!/tests/behavior/README.md
!/tests/rf_trace/
/tests/rf_trace/*
!/tests/rf_trace/*.py
!/tests/rf_trace/*.lua
!/tests/rf_trace/README.md
!/tests/picker/
/tests/picker/*
!/tests/picker/*.py
!/tests/picker/*.lua
!/tests/picker/README.md
!/tests/assets/
/tests/assets/*
!/tests/assets/*.py
!/tests/assets/README.md
!/tests/storage/
/tests/storage/*
!/tests/storage/*.py
!/tests/storage/*.lua
!/tests/storage/README.md
/src/*
!/src/shared/
/src/shared/*
!/src/shared/count_storage.lua
!/src/shared/msp_admission.lua
!/tests/msp_admission/
/tests/msp_admission/*
!/tests/msp_admission/*.py
!/tests/msp_admission/*.lua
!/tests/msp_admission/README.md

# Local future-widget design/reference document; do not publish.
/KSE_FUTURE_WIDGET_IMPLEMENTATION_BLUEPRINT.md

# KSE4 release source
/KSE4/*
!/KSE4/main.lua
!/KSE4/default.png
!/KSE4/default1.png
!/KSE4/BatterySounds/
/KSE4/BatterySounds/*
!/KSE4/BatterySounds/*.wav

# KSE5 release source
/KSE5/*
!/KSE5/main.lua
!/KSE5/default.png
!/KSE5/default1.png
!/KSE5/BatterySounds/
/KSE5/BatterySounds/*
