# Offline gallery, committed previews and maintainer generators.
/theme-gallery/*
!/theme-gallery/README.md
!/theme-gallery/assets/
!/theme-gallery/gallery.js
!/theme-gallery/generate_previews.py
!/theme-gallery/index.html
!/theme-gallery/styles.css
